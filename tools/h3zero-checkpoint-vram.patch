+class VramSamplerTests(unittest.TestCase):
+    def _stats(self, free):
+        return {
+            "devices": [
+                {
+                    "name": "NVIDIA RTX PRO 6000",
+                    "type": "cuda",
+                    "vram_total": 100,
+                    "vram_free": free,
+                }
+            ]
+        }
+
+    @patch("minimax_h3.comfy.system_stats")
+    def test_keeps_the_high_water_mark_not_the_last_reading(self, stats):
+        # Memory is released before the workflow returns, so a single reading
+        # taken at the end reports almost nothing. The peak is the number.
+        stats.side_effect = [self._stats(90), self._stats(10), self._stats(95)]
+        sampler = VramSampler(interval=0.01)
+        for _ in range(3):
+            sampler._sample()
+
+        report = sampler.report()
+        self.assertEqual(report["peak_used_bytes"], 90)
+        self.assertEqual(report["total_bytes"], 100)
+        self.assertEqual(report["peak_used_fraction"], 0.9)
+        self.assertEqual(report["samples"], 3)
+        self.assertEqual(report["device"], "NVIDIA RTX PRO 6000")
+
+    @patch("minimax_h3.comfy.system_stats")
+    def test_an_unreachable_endpoint_reports_nothing_rather_than_zero(self, stats):
+        stats.side_effect = OSError("connection refused")
+        sampler = VramSampler(interval=0.01)
+        sampler._sample()
+
+        self.assertIsNone(sampler.report())
+
+    @patch("minimax_h3.comfy.system_stats")
+    def test_context_manager_samples_around_the_body(self, stats):
+        stats.return_value = self._stats(40)
+        with VramSampler(interval=30) as sampler:
+            pass
+
+        # Entry and exit both sample, so a workflow shorter than one interval
+        # still produces a reading.
+        self.assertEqual(sampler.report()["peak_used_bytes"], 60)
+
+
 if __name__ == "__main__":
     unittest.main()
