         raise RuntimeError(f"ComfyUI is missing workflow nodes: {missing}")
 
 
+def system_stats(port: int = DEFAULT_PORT, timeout: float = 3) -> dict:
+    """Read ComfyUI's own device report, including VRAM totals."""
+    with urllib.request.urlopen(
+        f"http://127.0.0.1:{port}/system_stats", timeout=timeout
+    ) as response:
+        value = json.loads(response.read().decode("utf-8"))
+    return value if isinstance(value, dict) else {}
+
+
+class VramSampler:
+    """Track peak VRAM across a generation.
+
+    Diffusion happens in the ComfyUI subprocess, not here, so ``torch`` in this
+    process would report nothing. ComfyUI's own ``/system_stats`` reports the
+    device totals it sees, and the peak only exists while the workflow is
+    running -- reading it afterwards finds memory already released. So sample
+    on a thread for the duration and keep the high-water mark.
+    """
+
+    def __init__(self, port: int = DEFAULT_PORT, interval: float = 2.0):
+        self.port = port
+        self.interval = interval
+        self._stop = threading.Event()
+        self._thread: threading.Thread | None = None
+        self._total: int | None = None
+        self._device: str | None = None
+        self._peak_used: int = 0
+        self._samples: int = 0
+
+    def _sample(self) -> None:
+        try:
+            devices = system_stats(self.port).get("devices") or []
+        except Exception:
+            return
+        for device in devices:
+            if not isinstance(device, dict) or device.get("type") != "cuda":
+                continue
+            total = device.get("vram_total")
+            free = device.get("vram_free")
+            if not isinstance(total, int) or not isinstance(free, int):
+                continue
+            self._total = total
+            self._device = str(device.get("name") or "")
+            self._peak_used = max(self._peak_used, total - free)
+            self._samples += 1
+            return
+
+    def _run(self) -> None:
+        while not self._stop.wait(self.interval):
+            self._sample()
+
+    def __enter__(self) -> "VramSampler":
+        self._sample()
+        self._thread = threading.Thread(target=self._run, daemon=True)
+        self._thread.start()
+        return self
+
+    def __exit__(self, *_exception) -> None:
+        self._stop.set()
+        if self._thread is not None:
+            self._thread.join(timeout=self.interval + 5)
+        self._sample()
+
+    def report(self) -> dict | None:
+        """Return the peak reading, or ``None`` when nothing was sampled."""
+        if self._total is None or not self._samples:
+            return None
+        return {
+            "device": self._device,
+            "total_bytes": self._total,
+            "peak_used_bytes": self._peak_used,
+            "peak_used_gib": round(self._peak_used / 1024**3, 2),
+            "total_gib": round(self._total / 1024**3, 2),
+            "peak_used_fraction": round(self._peak_used / self._total, 4),
+            "samples": self._samples,
+            "sample_interval_seconds": self.interval,
+        }
+
+
