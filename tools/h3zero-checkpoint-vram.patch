+class ReferenceCheckpointTests(unittest.TestCase):
+    REFERENCES = [
+        {"id": "blockout", "kind": "video", "slot": 0, "local_filename": "b.mp4"},
+        {"id": "look_1", "kind": "image", "slot": 0, "local_filename": "l.png"},
+    ]
+
+    def _unet(self, **kwargs):
+        workflow = build_reference_workflow(
+            prompt="Keep <Video 1>; use <Picture 1>.",
+            width=864,
+            height=480,
+            duration_seconds=5,
+            seed=7,
+            references=self.REFERENCES,
+            **kwargs,
+        )
+        return workflow["model"]["inputs"]["unet_name"]
+
+    def test_reference_conditioning_defaults_to_ref2va(self):
+        self.assertEqual(self._unet(), "minimax_h3_ref2va_int8_convrot.safetensors")
+
+    def test_the_checkpoint_is_a_request_parameter(self):
+        # The point of the whole field: an A/B between the two checkpoints is
+        # two jobs, not two deployments.
+        self.assertEqual(
+            self._unet(reference_checkpoint="fl2va"),
+            "minimax_h3_fl2va_int8_convrot.safetensors",
+        )
+        self.assertEqual(
+            self._unet(reference_checkpoint="ref2va"),
+            "minimax_h3_ref2va_int8_convrot.safetensors",
+        )
+
+    def test_an_unknown_id_is_rejected_rather_than_loaded(self):
+        # unet_name is a filename ComfyUI reads off the model volume, so an
+        # unrecognized id must never reach it.
+        for value in ["../etc/passwd", "minimax_h3_ref2va_int8_convrot.safetensors", "", 4]:
+            with self.assertRaises(ValueError):
+                self._unet(reference_checkpoint=value)
+
+    def _lora(self, **kwargs):
+        workflow = build_reference_workflow(
+            prompt="Keep <Video 1>; use <Picture 1>.",
+            width=864,
+            height=480,
+            duration_seconds=5,
+            seed=7,
+            references=self.REFERENCES,
+            **kwargs,
+        )
+        return (workflow.get("turbo_lora") or {}).get("inputs", {}).get("lora_name")
+
+    def test_the_accelerator_defaults_to_the_matching_distillation(self):
+        self.assertEqual(
+            self._lora(reference_checkpoint="ref2va", sampling_profile="turbo_4"),
+            "minimax_h3_ref2v_turbo_4step_v0.1_comfyui_bf16.safetensors",
+        )
+        self.assertEqual(
+            self._lora(reference_checkpoint="fl2va", sampling_profile="turbo_4"),
+            "minimax_h3_fl2v_turbo_4step_v1.0_768p_comfyui_bf16.safetensors",
+        )
+        self.assertEqual(
+            self._lora(reference_checkpoint="fl2va", sampling_profile="turbo_8"),
+            "minimax_h3_fl2v_turbo_8step_v1.0_comfyui_bf16.safetensors",
+        )
+
+    def test_any_accelerator_pairs_with_any_checkpoint(self):
+        # Crossing a distillation onto weights it was not made from is a real
+        # risk to quality and a legitimate question. It has to be reachable, or
+        # it cannot be answered.
+        self.assertEqual(
+            self._lora(reference_checkpoint="ref2va", accelerator_lora="fl2v_turbo_4"),
+            "minimax_h3_fl2v_turbo_4step_v1.0_768p_comfyui_bf16.safetensors",
+        )
+        self.assertEqual(
+            self._lora(reference_checkpoint="fl2va", accelerator_lora="ref2v_turbo_4"),
+            "minimax_h3_ref2v_turbo_4step_v0.1_comfyui_bf16.safetensors",
+        )
+
+    def test_ref2va_with_turbo_8_falls_back_rather_than_refusing(self):
+        # There is no 8-step ref2v distillation. Defaulting to the fl2v one
+        # keeps the combination reachable; `none` is there when the crossing is
+        # not wanted.
+        self.assertEqual(
+            self._lora(reference_checkpoint="ref2va", sampling_profile="turbo_8"),
+            "minimax_h3_fl2v_turbo_8step_v1.0_comfyui_bf16.safetensors",
+        )
+
+    def test_none_loads_no_accelerator_at_all(self):
+        self.assertIsNone(
+            self._lora(reference_checkpoint="ref2va", accelerator_lora="none")
+        )
+
+    def test_an_unknown_accelerator_is_rejected(self):
+        with self.assertRaisesRegex(ValueError, "accelerator_lora must be one of"):
+            self._lora(reference_checkpoint="ref2va", accelerator_lora="wan_turbo")
+
+    def test_the_undistilled_profiles_work_with_either_checkpoint(self):
+        # base and spectrum sample the checkpoint directly, so they need no
