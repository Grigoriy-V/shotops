# Copy this file to `.env` and fill in your key. `.env` is gitignored.
# Real environment variables take priority over anything set here.

# PiAPI is the default provider: its omni_reference mode is the one that
# actually honours the blockout's camera. https://piapi.ai
PIAPI_KEY=

# CometAPI is kept as an alternative, but its Seedance route ignores references.
COMETAPI_KEY=

# Seedance accepts reference VIDEOS by URL only, so the blockout is uploaded to
# your own Supabase Storage bucket, passed as a signed URL, and deleted after.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=ai-render

# Where references are published. supabase (default) keeps them in your own
# bucket and deletes them after the job; piapi uses the provider's own store,
# which is what their playground uses and what their docs ask for -- "signed /
# expiring URLs may fail" -- at the cost of the file living on their server for
# 24 hours with no way to remove it early. Needs a Creator plan and PIAPI_KEY.
# AI_RENDER_UPLOADER=supabase

# Optional overrides
# AI_RENDER_URL_TTL=3600

# Default model variant. Lowest-precedence: a scene's "model" field overrides
# this, and `--model` on the command line overrides both.
# seedance-2-mini (default, cheapest) | seedance-2-fast | seedance-2 (1080p)
# AI_RENDER_PIAPI_TASK_TYPE=seedance-2-mini
# AI_RENDER_COMET_MODEL=seedance-2-5
# COMETAPI_BASE_URL=https://api.cometapi.com/v1
# AI_RENDER_BLENDER=D:\path\to\blender.exe
