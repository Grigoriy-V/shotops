# Secrets. Never commit; use .env.example as the template.
.env

# Portable Blender, ~890 MB.
.tools/

# Renders, generations, manifests -- all reproducible from projects/.
# Note the exception: <shot>/preview/ and <shot>/artifacts/ are committed on
# purpose -- the blockout, and the record of how the shot got decided.
out/

# Stills pulled back out of a committed render, for a contact sheet or a
# compare. The mp4 beside them is the record; these are one ffmpeg call away.
*_frames/

__pycache__/
*.pyc
